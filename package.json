{
  "name": "qookit",
  "private": true,
  "version": "0.5.0",
  "description": "QookiT - 一个基于 Tauri 2 与 russh 的可扩展 SSH 客户端",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bump": "node scripts/bump-version.mjs",
    "release:patch": "node scripts/bump-version.mjs patch && npm run tauri build",
    "release:minor": "node scripts/bump-version.mjs minor && npm run tauri build",
    "release:major": "node scripts/bump-version.mjs major && npm run tauri build"
  },
