# 统一换行符：仓库内一律以 LF 存储，避免 Windows / Unix 协作时产生无意义 diff
* text=auto eol=lf

# 需要保留 CRLF 的脚本
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件：禁止换行转换与文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.icns  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.dll   binary
*.exe   binary
*.so    binary
*.dylib binary

# 锁文件与 Schema：内容由工具生成，折叠 diff 并排除语言统计
pnpm-lock.yaml                  -diff linguist-generated
Cargo.lock                      -diff linguist-generated
src-tauri/gen/schemas/*.json    -diff linguist-generated
